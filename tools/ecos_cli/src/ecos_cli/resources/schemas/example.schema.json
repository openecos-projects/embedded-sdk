{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ECOS Example manifest, version 1",
  "description": "Application sources, logical resource requirements and optional Components.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "sources"],
  "properties": {
    "schema": {"const": 1},
    "name": {"$ref": "#/$defs/selection"},
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "include_dirs": {"$ref": "#/$defs/strings"},
    "defines": {"$ref": "#/$defs/strings"},
    "requires": {"$ref": "#/$defs/selections"},
    "components": {"$ref": "#/$defs/selections"},
    "unsupported_boards": {"$ref": "#/$defs/selections"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "selection": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": {"enum": [".", ".."]}
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "selections": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/selection"}
    }
  }
}
