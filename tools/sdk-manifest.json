{
  "schema_version": 1,
  "sdk_id": "ecos-embedded-sdk",
  "sdk_version": "3.1.0-dev.0",
  "channel": "development",
  "cli_compatibility": {
    "major": 3,
    "schema_version": "1.0"
  },
  "layout": {
    "boards": "boards",
    "components": "components",
    "drivers": "drivers",
    "devices": "devices",
    "docs": "docs",
    "examples": "examples",
    "hal": "hal",
    "cli": "tools/ecos_cli/src"
  },
  "build": {
    "core_components": [
      "core-runtime"
    ],
    "kconfig": "tools/ecos_cli/src/ecos_cli/resources/Kconfig.build"
  },
  "toolchain": {
    "id": "xpack-riscv-none-elf-gcc",
    "release": "15.2.0-1"
  },
  "release": {
    "paths": [
      "LICENSE",
      "README.md",
      "README_EN.md",
      "CODE_OF_CONDUCT.md",
      ".agents/skills/ecos-sdk",
      "components",
      "drivers",
      "hal",
      "boards",
      "examples",
      "docs",
      "devices",
      "tools/ecos_cli/src",
      "tools/ecos_cli/pyproject.toml",
      "tools/ecos_cli/README.md",
      "tools/ecos.py",
      "tools/install.py",
      "tools/install_skill.py",
      "tools/sdk-manifest.json"
    ],
    "exclude": [
      "boards/UserBSP",
      "components/core/tests",
      "drivers/i2c/tests",
      "drivers/qspi/tests"
    ]
  }
}
