{
  "schema_version": 1,
  "sdk_id": "ecos-embedded-sdk",
  "sdk_version": "3.0.0",
  "channel": "development",
  "cli_compatibility": {
    "major": 3,
    "schema_version": "1.0"
  },
  "layout": {
    "boards": "boards",
    "components": "components",
    "drivers": "drivers",
    "devices": "devices",
    "docs": "docs",
    "examples": "examples",
    "hal": "hal",
    "templates": "templates/project",
    "cli": "tools/ecos_cli/src"
  },
  "build": {
    "core_components": [
      "core-runtime"
    ],
    "kconfig": "tools/ecos_cli/src/ecos_cli/resources/Kconfig.build"
  },
  "toolchain": {
    "id": "xpack-riscv-none-elf-gcc",
    "release": "15.2.0-1"
  },
  "release": {
    "paths": [
      "LICENSE",
      "README.md",
      "README_EN.md",
      "CODE_OF_CONDUCT.md",
      "components",
      "drivers",
      "hal",
      "templates/project",
      "templates/bsp",
      "environments",
      "third_party",
      "boards",
      "examples",
      "docs",
      "devices",
      "tools/ecos_cli/src",
      "tools/ecos_cli/pyproject.toml",
      "tools/ecos_cli/README.md",
      "tools/ecos.py",
      "tools/install.py",
      "tools/sdk-manifest.json"
    ],
    "exclude": [
      "boards/UserBSP",
      "components/core/tests",
      "components/fatfs",
      "components/fcc",
      "examples/storage/fcc",
      "components/letter-shell",
      "components/letter-shell-fs",
      "components/spi_software",
      "components/text_editor",
      "examples/concurrency/letter-shell-smoke",
      "examples/storage/flash-fatfs",
      "examples/storage/text-editor",
      "drivers/i2c/tests",
      "drivers/qspi/tests",
      "boards/StarrySkyC1/Makefile",
      "boards/StarrySkyC1/Makefile_asm",
      "boards/StarrySkyC2/Makefile",
      "boards/StarrySkyC2/Makefile_asm",
      "boards/StarrySkyC2/Makefile_isolated",
      "boards/StarrySkyC2/build_conf.mk",
      "boards/StarrySkyL3/Makefile",
      "boards/StarrySkyL3/Makefile_asm",
      "boards/StarrySkyL3_1/Makefile",
      "boards/StarrySkyL3_1/Makefile_asm",
      "boards/StarrySkyL3_1/Makefile_isolated",
      "boards/StarrySkyL3_1/build_conf.mk",
      "boards/StarrySkyL4_C1/Makefile",
      "boards/StarrySkyL4_C1/Makefile_asm",
      "boards/StarrySkyL4_C1/Makefile_isolated",
      "boards/StarrySkyL4_C1/build_conf.mk",
      "boards/StarrySkyL4_C2/Makefile",
      "boards/StarrySkyL4_C2/Makefile_asm",
      "boards/StarrySkyL4_C2/Makefile_isolated",
      "boards/StarrySkyL4_C2/build_conf.mk",
      "boards/StarrySkyL4_C3/Makefile",
      "boards/StarrySkyL4_C3/Makefile_asm",
      "boards/StarrySkyL4_C3/Makefile_isolated",
      "boards/StarrySkyL4_C3/build_conf.mk",
      "boards/StarrySkyT1Pico/Makefile",
      "boards/StarrySkyT1Pico/Makefile_asm",
      "boards/StarrySkyT1Pico/build_conf.mk"
    ]
  }
}
