# StarrySkyL4 isolated firmware build script.
# This mirrors verif/ build behavior: compile to objects first, then link with ld.

CROSS ?= riscv-none-elf-
GCC_M ?= $(CROSS)gcc
LD_M ?= $(CROSS)ld
OBJDUMP_M ?= $(CROSS)objdump
OBJCOPY_M ?= $(CROSS)objcopy

BUILD_DIR := build
OBJ_DIR := $(BUILD_DIR)/obj
PROJECT_PATH := $(shell pwd)
CATEGORY := StarrySkyL4

-include configs/config/auto.conf

# ysyx8c2 cores are RV32E: 16 GPRs and no M. Use ilp32e so GCC
# never emits x16-x31 or hardware mul/div.
VERIF_CFLAGS := -Wall \
	  -std=gnu11 \
	  -march=rv32e \
	  -mabi=ilp32e \
	  -nostdlib \
	  -fdata-sections \
	  -ffunction-sections
CFLAGS := $(VERIF_CFLAGS)

CFLAGS += -DCONFIG_LINK_TARGET_MEM

ifdef CONFIG_BUILD_OPT_FLAGS
CFLAGS += $(subst ",,$(CONFIG_BUILD_OPT_FLAGS))
endif

ifdef CONFIG_BUILD_DEBUG
CFLAGS += -g -DDEBUG
endif

ifdef CONFIG_BUILD_VERBOSE
VERBOSE := 1
endif

ifdef CONFIG_FIRMWARE_NAME
FIRMWARE_NAME := $(subst ",,$(CONFIG_FIRMWARE_NAME))
else
FIRMWARE_NAME := main
endif
.DEFAULT_GOAL := $(FIRMWARE_NAME)

INCLUDE_DIRS := Library System Hardware

SDK_SRC_PATH := $(shell find $(INCLUDE_DIRS) -type f -name "*.S")
SDK_SRC_PATH += $(shell find $(INCLUDE_DIRS) -type f -name "*.c")

STARTUP_SRC := ./Startup/start.S
BOOTLOADER_SRC := ./Startup/loader/loader.c
APP_SRC := ./User/main.c $(SDK_SRC_PATH)
STARTUP_OBJ := $(OBJ_DIR)/$(STARTUP_SRC:.S=.o)
BOOTLOADER_OBJ := $(OBJ_DIR)/$(BOOTLOADER_SRC:.c=.o)
APP_OBJS := $(addprefix $(OBJ_DIR)/,$(patsubst %.S,%.o,$(patsubst %.c,%.o,$(APP_SRC))))
FIRMWARE_OBJS := $(STARTUP_OBJ) $(BOOTLOADER_OBJ) $(APP_OBJS)

CFLAGS += -I./ -I./configs
CFLAGS += $(addprefix -I,$(shell find $(INCLUDE_DIRS) -type d))
CFLAGS += $(addprefix -I,$(shell find User -type d))
CFLAGS += $(addprefix -I,$(shell find Startup -type d))

# Keep the verified L4 QSPI polling sequence independent of app optimization.
QSPI_SRCS := $(filter %/qspi.c,$(APP_SRC))
QSPI_OBJS := $(addprefix $(OBJ_DIR)/,$(QSPI_SRCS:.c=.o))
$(QSPI_OBJS): CFLAGS := $(filter-out -O%,$(CFLAGS)) -O0

FIRMWARE_LDS_PATH := $(shell find Startup -type f -name "sections.lds")
LDFLAGS := -e _start -melf32lriscv -z noexecstack -T $(FIRMWARE_LDS_PATH) --gc-sections

MEM_REPORT_CODE_IN_RAM := 1
-include ./scripts/mem_report.mk

$(OBJ_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	@$(GCC_M) $(CFLAGS) -c -o $@ $<

$(OBJ_DIR)/%.o: %.S
	@mkdir -p $(dir $@)
	@$(GCC_M) $(CFLAGS) -c -o $@ $<

# Keep the pre-PSRAM boot path self-contained, matching verif's flags.
$(BOOTLOADER_OBJ): $(BOOTLOADER_SRC) $(STARTUP_OBJ)
	@mkdir -p $(dir $@)
	@$(GCC_M) $(VERIF_CFLAGS) -c -o $@ $<

$(APP_OBJS): | $(BOOTLOADER_OBJ)

$(FIRMWARE_NAME): $(FIRMWARE_OBJS)
	@mkdir -p $(BUILD_DIR)
	@$(LD_M) $(LDFLAGS) -o $(BUILD_DIR)/$(FIRMWARE_NAME).elf --start-group $(FIRMWARE_OBJS) --end-group
	@$(OBJDUMP_M) -d $(BUILD_DIR)/$(FIRMWARE_NAME).elf > $(BUILD_DIR)/$(FIRMWARE_NAME).txt
	@$(OBJCOPY_M) -S -O binary $(BUILD_DIR)/$(FIRMWARE_NAME).elf $(BUILD_DIR)/$(FIRMWARE_NAME).bin
	@$(OBJCOPY_M) --change-addresses -0x30000000 -O verilog $(BUILD_DIR)/$(FIRMWARE_NAME).elf $(BUILD_DIR)/$(FIRMWARE_NAME).hex
	$(call show_mem_usage, $(BUILD_DIR)/$(FIRMWARE_NAME).elf)

clean:
	@rm -rf $(BUILD_DIR)

clean_config:
	@rm -rf configs/generated configs/config configs/.config configs/.config.old

clean_all:
	@rm -rf $(BUILD_DIR)
	@rm -rf configs/generated configs/config configs/.config configs/.config.old
	@rm -rf $(PROJECT_PATH)/tools/fixdep/build
	@rm -rf $(PROJECT_PATH)/tools/kconfig/build

-include scripts/config.mk

.PHONY: $(FIRMWARE_NAME) clean clean_config clean_all
