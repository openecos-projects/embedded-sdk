menu "System Read-Only Information"
    config STARTYSKY_T1
        bool "StartySky T1 Platform"
        default y

    config BOARD_RAM_TYPE_NAME
        string
        default "SDRAM" if LINK_TARGET_SDRAM
        default "DSRAM" if LINK_TARGET_FLASH_XIP

    config BOARD_RAM_SIZE_KB
        int
        default 32768 if LINK_TARGET_SDRAM
        default 16 if LINK_TARGET_FLASH_XIP

    config BOARD_FLASH_SIZE_KB
        int "Flash Size (KB)"
        default 16384
endmenu

menu "System Configuration"
    choice
        bool "Boot/Runtime Memory Selection"
        default LINK_TARGET_FLASH_XIP

        config LINK_TARGET_FLASH_XIP
            bool "Flash XIP"
            help
                代码和只读数据直接在 Flash 中执行，数据和栈位于 DSRAM。

        config LINK_TARGET_SDRAM
            bool "SDRAM (Loaded by Bootloader)"
            help
                FSBL 初始化 SDRAM，并将加载镜像搬运到 SDRAM 后执行。
    endchoice

    config CPU_FREQ_MHZ
        int "CPU Frequency (MHz)"
        default 20
        range 1 1000

    config UART_BAUD_RATE
        int "UART Baud Rate"
        default 115200
        range 1200 4000000
endmenu
