menu "Peripheral Drivers"
    config DRIVER_SYS_UART
        bool "SYS UART Driver Support"
        default y
        help
            Enable the StartySky T1 polled system UART driver.

    config DRIVER_GPIO
        bool "GPIO Driver Support"
        default n
        help
            Enable the StartySky T1 GPIO input/output driver.

    config DRIVER_INTERRUPT
        bool "Machine Interrupt and PLIC Driver Support"
        default n
        help
            Enable the StartySky T1 machine-mode trap entry and PLIC interrupt dispatch driver.

    config DRIVER_GPIO_INTERRUPT
        bool "GPIO External Interrupt Driver Support"
        depends on DRIVER_GPIO
        select DRIVER_INTERRUPT
        default n
        help
            Enable GPIO Port A pin external interrupts and single-pin callbacks.

    config DRIVER_TIMER
        bool "Timer Driver Support"
        default n
        help
            Enable the StartySky T1 polled Timer0 delay driver.

    config DRIVER_TIMER_INTERRUPT
        bool "Timer Interrupt Driver Support"
        depends on DRIVER_TIMER
        select DRIVER_INTERRUPT
        default n
        help
            Enable Timer0 periodic interrupts and callbacks.

    config DRIVER_CLINT
        bool "CLINT Driver Support"
        default n
        help
            Enable the CLINT mtime and mtimecmp high/low register access driver.

    config DRIVER_SDRAM
        bool "SDRAM Driver Support"
        default n
        help
            Enable the StartySky T1 SDRAM initialization driver with a fixed 20 MHz baseline.

    config DRIVER_I2C
        bool "I2C Driver Support"
        default n
        help
            Enable the StartySky T1 polled I2C0 master driver.

    config DRIVER_QSPI
        bool "QSPI Driver Support"
        default n
        help
            Enable the StartySky T1 polled QSPI0 master driver.
endmenu
