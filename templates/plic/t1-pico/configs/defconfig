# 选择 StartySky T1-Pico 并启用系统串口和机器中断驱动。
CONFIG_STARTYSKY_T1_PICO=y
CONFIG_DRIVER_SYS_UART=y
CONFIG_DRIVER_INTERRUPT=y
CONFIG_CPU_FREQ_MHZ=20
CONFIG_UART_BAUD_RATE=115200
CONFIG_BUILD_OPT_SIZE=y
CONFIG_BUILD_OPT_FLAGS="-Os"
CONFIG_BUILD_DEBUG=y
CONFIG_FIRMWARE_NAME="startysky_t1_pico_plic"
CONFIG_FIRMWARE_VERSION="1.0.0"
# CONFIG_LINK_LIBC is not set
# CONFIG_LINK_LIBGCC is not set
