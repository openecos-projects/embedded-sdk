#!/usr/bin/env bash
set -euo pipefail

# ECOS `set_board` subcommand
# Sets the board configuration for the project

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SDK_ROOT="$(dirname "$SCRIPT_DIR")"
export ECOS_SDK_HOME="${ECOS_SDK_HOME:-$SDK_ROOT}"

source "$SDK_ROOT/tools/scripts/ecos-board-package.sh"

# Color output
log() { echo -e "\033[1;32m[ECOS]\033[0m $*"; }
warn() { echo -e "\033[1;33m[WARN]\033[0m $*"; }
err() { echo -e "\033[1;31m[ERROR]\033[0m $*"; }

board_name=""
project_type=""
requested_profile=""

# Check if inside a project directory
check_project_dir() {
    if [[ ! -f "Makefile" ]] && [[ ! -f ".ecos-project" ]]; then
        err "Not an ECOS project directory."
        err "Run this command in a directory containing a Makefile or .ecos-project file."
        exit 1
    fi
}

get_config() {
    source .ecos-project

    board_name="${BOARD}"
    project_type="${TYPE:-}"

    echo "Project type: $project_type"
    echo "Board name: $board_name"
}

rewrite_config() {
    if [[ -f ".ecos-project" ]]; then
        source .ecos-project
        project_type="${TYPE:-$project_type}"
    fi

    echo "BOARD=$target_board_name" > ".ecos-project"
    if [[ -n "$project_type" ]]; then
        echo "TYPE=$project_type" >> ".ecos-project"
    fi
}

copy_if_declared() {
    local board_dir="$1"
    local source_rel="$2"
    local target_path="$3"
    local required="${4:-true}"
    local source_path

    if [[ -z "$source_rel" ]]; then
        if [[ "$required" == "true" ]]; then
            err "Board package manifest missing required file entry for target: $target_path"
            exit 1
        fi
        return 0
    fi
    source_path="$board_dir/$source_rel"

    if [[ ! -e "$source_path" ]]; then
        if [[ "$required" == "true" ]]; then
            err "Board package file not found: $source_path"
            exit 1
        fi
        return 0
    fi

    if [[ -d "$source_path" ]]; then
        rm -rf "$target_path"
        cp -r "$source_path" "$target_path"
    else
        cp "$source_path" "$target_path"
    fi
    log "Set $(basename "$target_path"): $target_path"
}

set_board_from_package() {
    local target_board_name="$1"
    local profile_request="${2:-}"
    local manifest board_dir board_id board_category
    local make_file board_file lds_file start_file loader_path profile

    manifest="$(ecos_board_find_manifest "$target_board_name")" || return 1
    ecos_board_validate_manifest "$manifest" || {
        err "Board package manifest is invalid: $manifest"
        exit 1
    }
    board_dir="$(ecos_board_manifest_dir "$manifest")"
    board_id="$(ecos_board_manifest_value "$manifest" id)"
    board_category="$(ecos_board_manifest_value "$manifest" category)"
    profile="$(ecos_board_resolve_profile "$manifest" "$profile_request")" || exit 1

    make_file="$(ecos_board_manifest_section_value "$manifest" files makefile)"
    board_file="$(ecos_board_manifest_section_value "$manifest" files board_header)"
    lds_file="$(ecos_board_profile_file "$manifest" "$profile" linker_script)"
    start_file="$(ecos_board_profile_file "$manifest" "$profile" startup)"
    loader_path="$(ecos_board_manifest_section_value "$manifest" paths loader)"

    rm -f ./start.S ./start.s
    rm -rf ./loader

    copy_if_declared "$board_dir" "$board_file" "./board.h" true
    copy_if_declared "$board_dir" "$make_file" "./Makefile" true
    copy_if_declared "$board_dir" "$lds_file" "./sections.lds" true
    copy_if_declared "$board_dir" "$start_file" "./start.S" true
    copy_if_declared "$board_dir" "$loader_path" "./loader" false

    mkdir -p configs
    ecos_board_write_project_config "$manifest" "configs/board-package.mk" "$profile"
    ecos_board_write_sdk_path_config "configs/sdk-path.mk"
    ecos_board_ensure_sdk_include "./Makefile"

    {
        echo "BOARD=$board_id"
        echo "BOARD_ID=$board_id"
        echo "BOARD_CATEGORY=$board_category"
        echo "BOARD_PACKAGE=$(realpath -m "$board_dir")"
        [[ -z "$profile" ]] || echo "PROFILE=$profile"
        echo "TYPE=$project_type"
    } > ".ecos-project"

    log "Board package: $board_id"
    [[ -z "$profile" ]] || log "Build profile: $profile"
    log "Board package path: $board_dir"
    log "Generated board package config: configs/board-package.mk"
    return 0
}
# Set board configuration
set_board() {
    local target_board_name="$1"
    local profile_request="${2:-}"

    check_project_dir
    if [[ -f ".ecos-project" ]]; then
        source .ecos-project
        project_type="${TYPE:-}"
    fi

    # AbstractMachine 工程保留根 Makefile，只刷新板卡和 SDK 路径元数据。
    if [[ "$project_type" == "abstract-machine" ]]; then
        local manifest board_id board_dir am_dir default_core template_name project_name

        if [[ -n "$profile_request" ]]; then
            err "AM 工程不使用 --profile；体系结构和核心配置由 BSP 的 AM 环境提供"
            exit 1
        fi

        manifest="$(ecos_board_find_manifest "$target_board_name" || true)"
        if [[ -z "$manifest" ]]; then
            err "找不到 BSP：$target_board_name"
            exit 1
        fi
        if ! ecos_board_validate_manifest "$manifest"; then
            err "BSP 清单无效：$manifest"
            exit 1
        fi
        board_id="$(ecos_board_manifest_value "$manifest" id)"
        board_dir="$(realpath -m "$(ecos_board_manifest_dir "$manifest")")"
        am_dir="$(ecos_board_am_environment_dir "$manifest" || true)"
        default_core="$(ecos_board_am_default_core "$manifest")"
        project_name="$(basename "$(pwd)")"

        if [[ -z "$am_dir" || -z "$default_core" ]]; then
            err "BSP 未声明完整的 abstract_machine.path/default_core：$manifest"
            exit 1
        fi
        if [[ ! -f "$am_dir/cores/$default_core.conf" ]]; then
            err "BSP 默认核心 profile 不存在：$default_core"
            exit 1
        fi
        mkdir -p configs
        {
            echo "# 由 ecos set_board 刷新。"
            printf 'ECOS_SDK_HOME := %s\n' "$(realpath -m "$SDK_ROOT")"
            printf 'AM_HOME := %s\n' "$(realpath -m "$SDK_ROOT/third_party/abstract-machine")"
            echo "BOARD_PACKAGE := $board_dir"
            echo "AM_BOARD_PORT_DIR := $(realpath -m "$am_dir")"
            echo "BOARD := $board_id"
            echo "AM_CORE_PROFILE := $default_core"
            echo "AM_PROJECT_NAME := $project_name"
        } > configs/abstract-machine.mk.tmp
        mv configs/abstract-machine.mk.tmp configs/abstract-machine.mk

        # 刷新板卡元数据和 SDK 路径文件。
        template_name="${TEMPLATE:-abstract-machine}"
        {
            echo "TYPE=abstract-machine"
            echo "BOARD=$board_id"
            echo "TEMPLATE=$template_name"
        } > .ecos-project.tmp
        mv .ecos-project.tmp .ecos-project
        ecos_board_write_sdk_path_config "configs/sdk-path.mk"
        log "Refreshed AbstractMachine environment: $board_id ($default_core)"
        return 0
    fi

    if [[ "$project_type" != "asm" ]] && set_board_from_package "$target_board_name" "$profile_request"; then
        return 0
    fi
    if [[ -n "$profile_request" ]]; then
        err "--profile 只能用于清单中定义了 profiles 的 BSP: $target_board_name"
        exit 1
    fi

    rewrite_config
    get_config

    if [[ "$project_type" == "asm" ]]; then
        local board_sdk_dir=""
        case "$target_board_name" in
            "c1") board_sdk_dir="$SDK_ROOT/board/StarrySkyC1" ;;
            "c2") board_sdk_dir="$SDK_ROOT/board/StarrySkyC2" ;;
            "l3") board_sdk_dir="$SDK_ROOT/board/StarrySkyL3" ;;
            "l3_1") board_sdk_dir="$SDK_ROOT/board/StarrySkyL3_1" ;;
            "l4") board_sdk_dir="$SDK_ROOT/board/StarrySkyL4" ;;
            "t1-pico") board_sdk_dir="$SDK_ROOT/board/StartySkyT1Pico" ;;
            *)
                err "Unsupported board: $target_board_name"
                exit 1
                ;;
        esac

        rm -f Makefile
        log "Removed Makefile for assembly project."
        log "Board configuration set to: $target_board_name"
        cp "$board_sdk_dir/Makefile_asm" "./Makefile"
        if [[ -f "$board_sdk_dir/flash.ld" ]]; then
            cp "$board_sdk_dir/flash.ld" "./flash.ld"
            log "Set flash-only linker script: ./flash.ld"
        fi
        exit 0
    fi

    case "$target_board_name" in
        "c1")
            local board_file="board.h"
            local make_file="Makefile"
            local lds_file="sections.lds"
            # local start_file="start.s" # C1 might not have start.s in board dir yet, checking...

            local board_source_path="$SDK_ROOT/board/StarrySkyC1/$board_file"
            local make_source_path="$SDK_ROOT/board/StarrySkyC1/$make_file"
            local lds_source_path="$SDK_ROOT/board/StarrySkyC1/$lds_file"

            local board_target_path="./board.h"
            local make_target_path="./Makefile"
            local lds_target_path="./sections.lds"

            if [[ ! -f "$board_source_path" ]]; then
                err "Board config file not found: $board_source_path"
                exit 1
            fi

            # Copy board config file
            cp "$board_source_path" "$board_target_path"
            log "Set board configuration to: starrysky_c1"
            log "Config file: $board_target_path"

            # Copy Makefile
            cp "$make_source_path" "$make_target_path"
            log "Set Makefile: $make_target_path"

            # Copy Linker Script
            if [[ -f "$lds_source_path" ]]; then
                cp "$lds_source_path" "$lds_target_path"
                log "Set Linker Script: $lds_target_path"
            fi

            # Copy start.s if exists (C1 support)
            if [[ -f "$SDK_ROOT/board/StarrySkyC1/start.s" ]]; then
                cp "$SDK_ROOT/board/StarrySkyC1/start.s" "./start.s"
                log "Set startup code: ./start.s"
            fi

            # Update project config file if it exists
            if [[ -f ".ecos-project" ]]; then
                if grep -q "BOARD=" ".ecos-project"; then
                    sed -i "s/BOARD=.*/BOARD=$target_board_name/" ".ecos-project"
                else
                    echo "BOARD=$target_board_name" >> ".ecos-project"
                fi
                log "Updated project configuration file."
            fi
            ;;
        "c2")
            local board_file="board.h"
            local make_file="Makefile"
            local lds_file="sections.lds"
            local start_file="start.S"

            local board_source_path="$SDK_ROOT/board/StarrySkyC2/$board_file"
            local make_source_path="$SDK_ROOT/board/StarrySkyC2/$make_file"
            local lds_source_path="$SDK_ROOT/board/StarrySkyC2/$lds_file"
            local start_source_path="$SDK_ROOT/board/StarrySkyC2/$start_file"

            local board_target_path="./board.h"
            local make_target_path="./Makefile"
            local lds_target_path="./sections.lds"
            local start_target_path="./start.S"

            if [[ ! -f "$board_source_path" ]]; then
                err "Board config file not found: $board_source_path"
                exit 1
            fi

            # Copy board config file
            cp "$board_source_path" "$board_target_path"
            log "Set board configuration to: starrysky_c2"
            log "Config file: $board_target_path"

            # Copy Makefile
            cp "$make_source_path" "$make_target_path"
            log "Set Makefile: $make_target_path"

            # Copy Linker Script
            if [[ -f "$lds_source_path" ]]; then
                cp "$lds_source_path" "$lds_target_path"
                log "Set Linker Script: $lds_target_path"
            else
                warn "Linker script not found for C2: $lds_source_path"
            fi

            # Copy startup code
            if [[ -f "$start_source_path" ]]; then
                cp "$start_source_path" "$start_target_path"
                log "Set startup code: $start_target_path"
            else
                warn "Startup code not found for C2: $start_source_path"
            fi

            # Update project config file if it exists
            if [[ -f ".ecos-project" ]]; then
                if grep -q "BOARD=" ".ecos-project"; then
                    sed -i "s/BOARD=.*/BOARD=$target_board_name/" ".ecos-project"
                else
                    echo "BOARD=$target_board_name" >> ".ecos-project"
                fi
                log "Updated project configuration file."
            fi
            ;;
        "l3")
            local board_file="board.h"
            local make_file="Makefile"
            local lds_file="sections.lds"

            local board_source_path="$SDK_ROOT/board/StarrySkyL3/$board_file"
            local make_source_path="$SDK_ROOT/board/StarrySkyL3/$make_file"
            local lds_source_path="$SDK_ROOT/board/StarrySkyL3/$lds_file"

            local board_target_path="./board.h"
            local make_target_path="./Makefile"
            local lds_target_path="./sections.lds"

            if [[ ! -f "$board_source_path" ]]; then
                err "Board config file not found: $board_source_path"
                exit 1
            fi

            # Copy board config file
            cp "$board_source_path" "$board_target_path"
            log "Set board configuration to: starrysky_l3"
            log "Config file: $board_target_path"

            # Copy Makefile
            cp "$make_source_path" "$make_target_path"
            log "Set Makefile: $make_target_path"

            # Copy Linker Script
            if [[ -f "$lds_source_path" ]]; then
                cp "$lds_source_path" "$lds_target_path"
                log "Set Linker Script: $lds_target_path"
            fi

            # Copy start.s if exists
            if [[ -f "$SDK_ROOT/board/StarrySkyL3/start.s" ]]; then
                cp "$SDK_ROOT/board/StarrySkyL3/start.s" "./start.s"
                log "Set startup code: ./start.s"
            fi

            # Copy bootloader
            local bootloader_source_path="$SDK_ROOT/board/StarrySkyL3/loader"
            local bootloader_target_path="./loader"
            cp -r "$bootloader_source_path" "$bootloader_target_path"
            log "Set bootloader: $bootloader_target_path"

            # Update project config file if it exists
            if [[ -f ".ecos-project" ]]; then
                if grep -q "BOARD=" ".ecos-project"; then
                    sed -i "s/BOARD=.*/BOARD=$target_board_name/" ".ecos-project"
                else
                    echo "BOARD=$target_board_name" >> ".ecos-project"
                fi
                log "Updated project configuration file."
            fi
            ;;
        "l3_1")
            local board_file="board.h"
            local make_file="Makefile"
            local lds_file="sections.lds"

            local board_source_path="$SDK_ROOT/board/StarrySkyL3_1/$board_file"
            local make_source_path="$SDK_ROOT/board/StarrySkyL3_1/$make_file"
            local lds_source_path="$SDK_ROOT/board/StarrySkyL3_1/$lds_file"

            local board_target_path="./board.h"
            local make_target_path="./Makefile"
            local lds_target_path="./sections.lds"

            if [[ ! -f "$board_source_path" ]]; then
                err "Board config file not found: $board_source_path"
                exit 1
            fi

            # Copy board config file
            cp "$board_source_path" "$board_target_path"
            log "Set board configuration to: starrysky_l3_1"
            log "Config file: $board_target_path"

            # Copy Makefile
            cp "$make_source_path" "$make_target_path"
            log "Set Makefile: $make_target_path"

            # Copy Linker Script
            if [[ -f "$lds_source_path" ]]; then
                cp "$lds_source_path" "$lds_target_path"
                log "Set Linker Script: $lds_target_path"
            fi

             # Copy start.S if exists
            if [[ -f "$SDK_ROOT/board/StarrySkyL3_1/start.S" ]]; then
                cp "$SDK_ROOT/board/StarrySkyL3_1/start.S" "./start.S"
                log "Set startup code: ./start.S"
            fi

            # Copy bootloader
            local bootloader_source_path="$SDK_ROOT/board/StarrySkyL3_1/loader"
            local bootloader_target_path="./loader"
            cp -r "$bootloader_source_path" "$bootloader_target_path"
            log "Set bootloader: $bootloader_target_path"

            # Update project config file if it exists
            if [[ -f ".ecos-project" ]]; then
                if grep -q "BOARD=" ".ecos-project"; then
                    sed -i "s/BOARD=.*/BOARD=$target_board_name/" ".ecos-project"
                else
                    echo "BOARD=$target_board_name" >> ".ecos-project"
                fi
                log "Updated project configuration file."
            fi
            ;;
        "l4")
            local board_file="board.h"
            local make_file="Makefile"
            local lds_file="sections.lds"

            local board_source_path="$SDK_ROOT/board/StarrySkyL4/$board_file"
            local make_source_path="$SDK_ROOT/board/StarrySkyL4/$make_file"
            local lds_source_path="$SDK_ROOT/board/StarrySkyL4/$lds_file"

            local board_target_path="./board.h"
            local make_target_path="./Makefile"
            local lds_target_path="./sections.lds"

            if [[ ! -f "$board_source_path" ]]; then
                err "Board config file not found: $board_source_path"
                exit 1
            fi

            # Copy board config file
            cp "$board_source_path" "$board_target_path"
            log "Set board configuration to: starrysky_l4"
            log "Config file: $board_target_path"

            # Copy Makefile
            cp "$make_source_path" "$make_target_path"
            log "Set Makefile: $make_target_path"

            # Copy Linker Script
            if [[ -f "$lds_source_path" ]]; then
                cp "$lds_source_path" "$lds_target_path"
                log "Set Linker Script: $lds_target_path"
            fi

             # Copy start.S if exists
            if [[ -f "$SDK_ROOT/board/StarrySkyL4/start.S" ]]; then
                cp "$SDK_ROOT/board/StarrySkyL4/start.S" "./start.S"
                log "Set startup code: ./start.S"
            fi

            # Copy bootloader
            local bootloader_source_path="$SDK_ROOT/board/StarrySkyL4/loader"
            local bootloader_target_path="./loader"
            rm -rf "$bootloader_target_path"
            cp -r "$bootloader_source_path" "$bootloader_target_path"
            log "Set bootloader: $bootloader_target_path"

            # Update project config file if it exists
            if [[ -f ".ecos-project" ]]; then
                if grep -q "BOARD=" ".ecos-project"; then
                    sed -i "s/BOARD=.*/BOARD=$target_board_name/" ".ecos-project"
                else
                    echo "BOARD=$target_board_name" >> ".ecos-project"
                fi
                log "Updated project configuration file."
            fi
            ;;
        *)
            err "Unsupported board: $target_board_name"
            echo ""
            echo "Supported boards:"
            echo "  c1    StarrySky C1 board"
            echo "  c2    StarrySky C2 board"
            echo "  l3    StarrySky L3 board"
            echo "  l3_1  StarrySky L3_1 board"
            echo "  l4    StarrySky L4 board"
            echo "  Use 'ecos board list' for package-discovered boards."
            exit 1
            ;;
    esac

    mkdir -p configs
    ecos_board_write_sdk_path_config "configs/sdk-path.mk"
    ecos_board_ensure_sdk_include "./Makefile"
}

# Main entry point for the subcommand
if [[ $# -eq 0 ]]; then
    err "Missing board name argument."
    echo ""
    echo "Usage: ecos set_board <board_name> [--profile <name>]"
    echo "Example: ecos set_board c1"
    exit 1
fi

target_board_name="$1"
shift
if [[ $# -gt 0 ]]; then
    [[ $# -eq 2 && "$1" == "--profile" ]] || {
        err "Usage: ecos set_board <board_name> [--profile <name>]"
        exit 1
    }
    requested_profile="$2"
fi
set_board "$target_board_name" "$requested_profile"
