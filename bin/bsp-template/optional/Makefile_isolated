# @BSP_NAME@ 分离式工程构建文件。
# [不要修改] 分离式工程的目录名称由 ecos init_project 约定。
-include configs/config/auto.conf

BUILD_DIR := build
INCLUDE_DIRS := Startup Library User System Hardware

# [必须修改] TODO_BSP_REQUIRED：确认工具链前缀、指令集和 ABI。
CROSS ?= riscv64-unknown-elf-
CFLAGS := -Wall -std=gnu11 -march=rv32im -mabi=ilp32 -ffreestanding -nostdlib
CFLAGS += $(addprefix -I,$(shell find $(INCLUDE_DIRS) -type d))

ifdef CONFIG_FIRMWARE_NAME
FIRMWARE_NAME := $(subst ",,$(CONFIG_FIRMWARE_NAME))
else
FIRMWARE_NAME := main
endif

SRC_PATH := $(shell find $(INCLUDE_DIRS) -type f -name "*.S")
SRC_PATH += $(shell find $(INCLUDE_DIRS) -type f -name "*.c")
LDS_PATH := $(shell find Startup -type f -name "sections.lds")

# [必须修改] TODO_BSP_REQUIRED：确认链接参数和输出格式。
$(FIRMWARE_NAME):
	@mkdir -p $(BUILD_DIR)
	@$(CROSS)gcc $(CFLAGS) -T $(LDS_PATH) -o $(BUILD_DIR)/$(FIRMWARE_NAME).elf $(SRC_PATH)
	@$(CROSS)objcopy -O binary $(BUILD_DIR)/$(FIRMWARE_NAME).elf $(BUILD_DIR)/$(FIRMWARE_NAME).bin
	@$(CROSS)objdump -d $(BUILD_DIR)/$(FIRMWARE_NAME).elf > $(BUILD_DIR)/$(FIRMWARE_NAME).txt

clean:
	@rm -rf $(BUILD_DIR)

-include scripts/config.mk

.PHONY: $(FIRMWARE_NAME) clean
