menu "System Read-Only Information"
    choice
        bool "Target SoC Platform"
        default @BSP_SYMBOL@

    # [Do not modify] ecos board create generates the configuration name from the BSP ID.
    config @BSP_SYMBOL@
        bool "@BSP_NAME@ Platform"
    endchoice

    config BOARD_RAM_TYPE_NAME
        string "RAM Type Name"
        # [Required] TODO_BSP_REQUIRED: set the actual memory type, such as SRAM or PSRAM.
        default "SRAM"

    config BOARD_RAM_SIZE_KB
        int "RAM Size (KB)"
        # [Required] TODO_BSP_REQUIRED: set the available RAM size.
        default 1

    config BOARD_FLASH_SIZE_KB
        int "Flash Size (KB)"
        # [Required] TODO_BSP_REQUIRED: set the available Flash size.
        default 1
endmenu

menu "System Configuration"
    config CPU_FREQ_MHZ
        int "CPU Frequency (MHz)"
        # [Required] TODO_BSP_REQUIRED: set the actual CPU frequency after power-on.
        default 1
        range 1 1000

    config UART_BAUD_RATE
        int "UART Baud Rate"
        # [Optional] The default UART baud rate; the driver must use the same setting.
        default 115200
        range 1 4000000
endmenu
