#!/usr/bin/env bash
set -euo pipefail

# ECOS `init_project` subcommand
# Initializes a new project from a template

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SDK_ROOT="$(dirname "$SCRIPT_DIR")"
export ECOS_SDK_HOME="${ECOS_SDK_HOME:-$SDK_ROOT}"

source "$SDK_ROOT/tools/scripts/ecos-board-package.sh"

# Color output
log()  { echo -e "\033[1;32m[ECOS]\033[0m $*";  }
warn() { echo -e "\033[1;33m[WARN]\033[0m $*";  }
err()  { echo -e "\033[1;31m[ERROR]\033[0m $*"; }
tips() { echo -e "\033[1;94m[ECOS]\033[0m $*";  }

echo_available_templates() {
    log "Available project templates:"
    echo "| project_name     | c1 | c2 | l3 | l3_1 | l4 | t1 |"
    echo "|------------------|----|----|----|------|----|----|"
    echo "| archinfo         |    |    |    | √    | √  |    |"
    echo "| asm_gpio         |    |    | √  | √    | √  | √  |"
    echo "| asm_hello        | √  | √  | √  | √    | √  | √  |"
    echo "| crc              |    |    |    | √    | √  |    |"
    echo "| gpio             | √  | √  | √  | √    | √  | √  |"
    echo "| hello            | √  | √  | √  | √    | √  | √  |"
    echo "| i2c_eeprom       |    |    |    |      |    | √  |"
    echo "| i2c_scan         | √  | √  | √  | √    |    | √  |"
    echo "| i2c_sgp30        | √* |    |    | √    |    |    |"
    echo "| minesweeper      | √  | √  |    | √    | √  |    |"
    echo "| ps2              |    |    |    | √    |    |    |"
    echo "| pwm              | √* |    |    | √    | √  |    |"
    echo "| qspi             |    |    |    | √    | √  |    |"
    echo "| qspi_psram       |    |    |    |      |    | √  |"
    echo "| rcu              |    |    |    | √    |    |    |"
    echo "| rng              |    |    |    | √    | √  |    |"
    echo "| rtc              |    |    |    | √    |    |    |"
    echo "| smoke_test       |    |    |    | √    | √  |    |"
    echo "| spi_st7735       | √* | √  |    | √    | √  |    |"
    echo "| spi_st7735_clock | √* |    |    | √    | √  |    |"
    echo "| spi_st7735_donut | √  | √  |    | √    | √  |    |"
    echo "| st7789           |    | √  |    | √    | √  |    |"
    echo "| timer            |    |    |    | √    | √  | √  |"
    echo "| wdg              |    |    |    | √    |    |    |"
    echo "| spi_flash_test   |    | √  |    |      |    |    |"
    echo "| filesystem_test  |    | √  |    |      |    |    |"
    echo "| shell_test       |    | √  |    |      |    |    |"
    echo "| coroutine_test   |    | √  |    |      |    |    |"
    echo "|------------------|----|----|----|------|----|----|"
    echo "  * means supported but code is in root dir instead of board specific dir"
}

resolve_template_dir() {
    local template_name="$1"
    local target_board="$2"
    local manifest

    manifest="$(ecos_board_find_manifest "$target_board" || true)"
    if [[ -n "$manifest" ]]; then
        ecos_board_resolve_template "$manifest" "$template_name" "$target_board"
        return $?
    fi

    if [[ -d "$SDK_ROOT/templates/$template_name/$target_board" ]]; then
        echo "$SDK_ROOT/templates/$template_name/$target_board"
        return 0
    fi
    if [[ -d "$SDK_ROOT/templates/$template_name/common" ]]; then
        echo "$SDK_ROOT/templates/$template_name/common"
        return 0
    fi
    return 1
}

# The actual init_project logic
init_project() {
    local template_name="$1"
    local new_project_name="${2:-$1}"
    local target_board="${3:-}"
    local requested_profile="${4:-}"
    local manifest profile=""

    if [[ "$new_project_name" == "" ]]; then
        new_project_name="$template_name"
    fi

    if [[ "$template_name" == "list" ]]; then
        echo_available_templates
        exit 0
    fi

    # Check if project directory exists
    if [[ -d "$new_project_name" ]]; then
        err "Project directory already exists: $new_project_name"
        exit 1
    fi

    manifest="$(ecos_board_find_manifest "$target_board" || true)"
    if [[ -n "$manifest" ]]; then
        if ! ecos_board_validate_manifest "$manifest"; then
            err "Board package manifest is invalid: $manifest"
            exit 1
        fi
        profile="$(ecos_board_resolve_profile "$manifest" "$requested_profile")" || exit 1
    elif [[ -n "$requested_profile" ]]; then
        err "--profile 只能用于清单中定义了 profiles 的 BSP: $target_board"
        exit 1
    fi

    # Copy project template from templates directory
    log "Initializing project '$new_project_name' from template '$template_name'..."
    if [[ $template_name == "asm_hello" || $template_name == "asm_gpio" ]]; then

        if [[ ! -d "$SDK_ROOT/templates/$template_name/$target_board" ]]; then
            err "Target project is not supported for board: $target_board"
            echo_available_templates
            exit 1
        fi

        cp -r "$SDK_ROOT/templates/$template_name/$target_board" "$new_project_name"
        cd "$new_project_name"
        echo "BOARD=$target_board" > ".ecos-project"
        echo "TYPE=asm" >> ".ecos-project"
        log "BOARD=$target_board"
        log "Initialized project: $new_project_name"
        log "Config file: .ecos-project"
        "$SCRIPT_DIR/ecos-set_board" "$target_board"
        log "Project '$new_project_name' created successfully in './$new_project_name'"
        exit 0
    else
        local template_dir
        template_dir="$(resolve_template_dir "$template_name" "$target_board")" || {
            err "Target project is not supported for board: $target_board"
            echo_available_templates
            exit 1
        }
        cp -r "$template_dir" "$new_project_name"
    fi
    cd "$new_project_name"

    # Initialize project config file
    local board_to_set="${target_board:-c1}"
    echo "BOARD=${board_to_set}" > ".ecos-project"
    [[ -z "$profile" ]] || echo "PROFILE=${profile}" >> ".ecos-project"
    log "Initialized project: $new_project_name"
    log "Config file: .ecos-project"

    # Set default board
    if [[ -n "$profile" ]]; then
        "$SCRIPT_DIR/ecos-set_board" "${board_to_set}" --profile "$profile"
    else
        "$SCRIPT_DIR/ecos-set_board" "${board_to_set}"
    fi

    # Create configs directory and copy scripts
    mkdir -p configs
    ecos_board_write_sdk_path_config "configs/sdk-path.mk"
    ecos_board_ensure_sdk_include "./Makefile"
    cp -r "$SDK_ROOT/tools/scripts/" "."
    log "Project '$new_project_name' created successfully in './$new_project_name'"
    tips "SDK path saved in configs/sdk-path.mk. If the SDK moves, run: eval \"\$(ecos env)\""
}

init_project_isolated() {
    local template_name="${1:-hello}"
    local isolated_project_name="${2:-HelloWorld}"
    local target_board="${3:-c2}"
    local requested_profile="${4:-}"
    local LibraryDir="$isolated_project_name/Library"
    local StartupDir="$isolated_project_name/Startup"
    local UserDir="$isolated_project_name/User"
    local HardwareDir="$isolated_project_name/Hardware"
    local SystemDir="$isolated_project_name/System"

    # Check if project directory exists
    if [[ -d "$isolated_project_name" ]]; then
        err "Project directory already exists: $isolated_project_name"
        exit 1
    fi

    local template_dir manifest isolated_makefile profile=""
    manifest="$(ecos_board_find_manifest "$target_board" || true)"
    if [[ -n "$manifest" ]]; then
        if ! ecos_board_validate_manifest "$manifest"; then
            err "Board package manifest is invalid: $manifest"
            exit 1
        fi
        profile="$(ecos_board_resolve_profile "$manifest" "$requested_profile")" || exit 1
        isolated_makefile="$(ecos_board_manifest_section_value "$manifest" files makefile_isolated)"
        if [[ -z "$isolated_makefile" && -f "$(ecos_board_manifest_dir "$manifest")/Makefile_isolated" ]]; then
            isolated_makefile=Makefile_isolated
        fi
        if [[ -z "$isolated_makefile" ]]; then
            err "Board package does not provide an isolated Makefile: $target_board"
            exit 1
        fi
    elif [[ -n "$requested_profile" ]]; then
        err "--profile 只能用于清单中定义了 profiles 的 BSP: $target_board"
        exit 1
    fi
    template_dir="$(resolve_template_dir "$template_name" "$target_board" || true)"
    if [[ -z "$template_dir" ]]; then
        err "Target project is not supported for board: $target_board (template: $template_name)"
        exit 1
    fi

    # Copy project source must needed from sdk
    log "Initializing project '$isolated_project_name' isolated..."
    mkdir -p "$LibraryDir"
    mkdir -p "$StartupDir"
    mkdir -p "$UserDir"
    mkdir -p "$HardwareDir"
    mkdir -p "$SystemDir"

    find "$SDK_ROOT/components/libc" -type f -exec cp {} "$LibraryDir/" \;
    find "$SDK_ROOT/components/libgcc" -type f -exec cp {} "$LibraryDir/" \;
    find "$SDK_ROOT/hal" -type f -exec cp {} "$LibraryDir/" \;
    cp -r "$SDK_ROOT/components/spi_software" "$SystemDir"
    cp -r "$SDK_ROOT/components/sfud" "$SystemDir"
    cp -r "$SDK_ROOT/components/fatfs" "$SystemDir"
    cp -r "$SDK_ROOT/components/letter-shell" "$SystemDir"
    cp -r "$SDK_ROOT/components/TimmoLog" "$SystemDir"
    cp -r "$SDK_ROOT/components/fcc" "$SystemDir"
    cp -r "$SDK_ROOT/components/text_editor" "$SystemDir"

    # due to diversity of the device drivers, copy its whole structure
    find "$SDK_ROOT/devices" -maxdepth 1 -mindepth 1 -type d -exec cp -r {} "$HardwareDir" \;
    cp "$SDK_ROOT/docs/isolated_project.md" "$isolated_project_name"


    cd "$isolated_project_name"
    # Initialize project config file
    local board_to_set="${target_board:-c2}"
    echo "BOARD=${board_to_set}" > ".ecos-project"
    echo "TEMPLATE=${template_name}" >> ".ecos-project"
    [[ -z "$profile" ]] || echo "PROFILE=${profile}" >> ".ecos-project"
    log "Initialized project: $isolated_project_name"
    log "Config file: .ecos-project"

    # Set default board
    if [[ -n "$profile" ]]; then
        "$SCRIPT_DIR/ecos-set_board_isolated" "${board_to_set}" --profile "$profile"
    else
        "$SCRIPT_DIR/ecos-set_board_isolated" "${board_to_set}"
    fi

    # ecos-set_board_isolated has copied local scripts, kconfig and fixdep.
    mkdir -p configs
    log "Project '$isolated_project_name' created successfully in './$isolated_project_name'"
    tips "The project contains local Kconfig/fixdep tools and no longer needs ECOS_SDK_HOME."
    tips "The first configuration build requires host gcc, flex and bison; menuconfig also requires ncurses."
}

# Main entry point for the subcommand
if [[ $# -eq 0 ]]; then
    err "Missing project name or 'list' argument"
    echo ""
    echo "Usage: ecos init_project <template_name> [-name new_project_name] [-target target_board] [--profile name]"
    echo "       ecos init_project list"
    echo "Example: ecos init_project hello"
    echo "         ecos init_project hello -name my_new_hello"
    echo "         ecos init_project hello -name my_new_hello -target l3"
    echo "         ecos init_project my_project -isolated"
    echo "         ecos init_project my_project -isolated -target c2"
    echo "         ecos init_project my_project -isolated -name my_new_project -target c2"
    exit 1
fi

template_name=""
new_project_name=""
target_board=""
requested_profile=""
isIsolated=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -name)
            new_project_name="$2"
            shift 2
            ;;
        -target)
            target_board="$2"
            shift 2
            ;;
        -isolated)
            isIsolated=true
            shift 1
            ;;
        --profile|-profile)
            [[ $# -ge 2 ]] || { err "$1 requires a value"; exit 1; }
            requested_profile="$2"
            shift 2
            ;;
        *)
            if [[ -z "$template_name" ]]; then
                template_name="$1"
                shift 1
            else
                err "Unknown argument: $1"
                exit 1
            fi
            ;;
    esac
done

if [[ -z "$template_name" ]]; then
    err "Missing template name."
    exit 1
fi

if [[ "${isIsolated:-false}" == false ]]; then
    init_project "$template_name" "${new_project_name:-$template_name}" "${target_board:-c2}" "$requested_profile"
else
    init_project_isolated "$template_name" "${new_project_name:-$template_name}" "${target_board:-c2}" "$requested_profile"
fi
