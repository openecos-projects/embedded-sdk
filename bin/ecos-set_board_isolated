#!/usr/bin/env bash
set -euo pipefail

# ECOS `set_board` subcommand
# Sets the board configuration for the project

# WARN: only C2 was checked!!!
# TODO: support C1  / L3

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SDK_ROOT="$(dirname "$SCRIPT_DIR")"
export ECOS_SDK_HOME="${ECOS_SDK_HOME:-$SDK_ROOT}"

source "$SDK_ROOT/tools/scripts/ecos-board-package.sh"

# Color output
log() { echo -e "\033[1;32m[ECOS]\033[0m $*"; }
warn() { echo -e "\033[1;33m[WARN]\033[0m $*"; }
err() { echo -e "\033[1;31m[ERROR]\033[0m $*"; }

board_name=""
project_type=""
template_name="hello"
requested_profile=""

replace_board_drivers() {
    local source_path="$1"
    local library_path="$2"
    local managed_path="$library_path/BoardDrivers"
    local legacy_driver_names=(
        archinfo crc gpio hp_uart i2c ps2 pwm qspi rcu rng rtc sys_uart timer wdg
    )

    # Older isolated projects flattened board drivers into Library/. Remove only
    # those SDK-owned legacy files, then keep future board files in one tree.
    local driver_name
    for driver_name in "${legacy_driver_names[@]}"; do
        rm -f "$library_path/$driver_name.c"
    done

    rm -rf "$managed_path"
    mkdir -p "$managed_path"
    cp -r "$source_path/." "$managed_path/"
}

replace_loader() {
    local source_path="$1"
    local startup_path="$2"

    rm -rf "$startup_path/loader"
    if [[ -n "$source_path" && -d "$source_path" ]]; then
        cp -r "$source_path" "$startup_path/"
    fi
}

install_default_main() {
    local source_path="$1"
    local user_path="$2"

    if compgen -G "$user_path/main.*" > /dev/null; then
        log "Preserved existing User/main.* files."
        return
    fi

    find "$source_path" -type f -name "main.*" -exec cp {} "$user_path" \;
    log "Set default Main Files: $user_path"
}

refresh_project_support() {
    rm -rf ./scripts
    cp -r "$SDK_ROOT/tools/scripts" ./scripts

    mkdir -p ./tools
    rm -rf ./tools/kconfig ./tools/fixdep
    cp -r "$SDK_ROOT/tools/kconfig" ./tools/
    cp -r "$SDK_ROOT/tools/fixdep" ./tools/
    # Host binaries and dependency files are not portable across machines.
    rm -rf ./tools/kconfig/build ./tools/fixdep/build

    mkdir -p ./configs
    rm -rf ./configs/generated ./configs/config \
        ./configs/.config ./configs/.config.old
    rm -f ./configs/sdk-path.mk
    if [[ -f ./Makefile ]]; then
        sed -i '\|^-include configs/sdk-path.mk$|d' ./Makefile
    fi

    log "Refreshed local build support: ./scripts and ./tools (source only)"
    warn "Board-dependent configuration was cleared; run make alldefconfig or make defconfig."
}

set_board_from_package() {
    local target_board_name="$1"
    local profile_request="${2:-}"
    local manifest board_dir board_id board_category
    local board_file make_file lds_file start_file drivers_path loader_path
    local board_kconfig driver_kconfig template_dir profile

    manifest="$(ecos_board_find_manifest "$target_board_name")" || return 1
    ecos_board_validate_manifest "$manifest" || {
        err "Board package manifest is invalid: $manifest"
        exit 1
    }

    board_dir="$(ecos_board_manifest_dir "$manifest")"
    board_id="$(ecos_board_manifest_value "$manifest" id)"
    board_category="$(ecos_board_manifest_value "$manifest" category)"
    profile="$(ecos_board_resolve_profile "$manifest" "$profile_request")" || exit 1
    board_file="$(ecos_board_manifest_section_value "$manifest" files board_header)"
    make_file="$(ecos_board_manifest_section_value "$manifest" files makefile_isolated)"
    lds_file="$(ecos_board_profile_file "$manifest" "$profile" linker_script)"
    start_file="$(ecos_board_profile_file "$manifest" "$profile" startup)"
    drivers_path="$(ecos_board_manifest_section_value "$manifest" paths drivers)"
    loader_path="$(ecos_board_manifest_section_value "$manifest" paths loader)"
    board_kconfig="$(ecos_board_manifest_section_value "$manifest" kconfig board)"
    driver_kconfig="$(ecos_board_manifest_section_value "$manifest" kconfig drivers)"
    [[ -n "$drivers_path" ]] || drivers_path=driver
    if [[ -z "$make_file" && -f "$board_dir/Makefile_isolated" ]]; then
        make_file=Makefile_isolated
    fi
    if [[ -z "$make_file" || ! -f "$board_dir/$make_file" ]]; then
        err "Board package does not provide an isolated Makefile: $board_id"
        exit 1
    fi

    template_dir="$(ecos_board_resolve_template "$manifest" "$template_name" "$target_board_name" || true)"
    if [[ -z "$template_dir" ]]; then
        err "Board package does not support template '$template_name': $board_id"
        exit 1
    fi

    mkdir -p Library Startup User configs Library/BoardConfig
    cp "$board_dir/$board_file" ./Library/board.h
    cp "$board_dir/$make_file" ./Makefile
    cp "$board_dir/$lds_file" ./Startup/sections.lds
    cp "$board_dir/$start_file" "./Startup/start.S"
    replace_board_drivers "$board_dir/$drivers_path" ./Library
    if [[ -n "$loader_path" ]]; then
        replace_loader "$board_dir/$loader_path" ./Startup
    else
        replace_loader "" ./Startup
    fi
    cp "$board_dir/$board_kconfig" ./Library/BoardConfig/board.kconfig
    cp "$board_dir/$driver_kconfig" ./Library/BoardConfig/driver.kconfig
    install_default_main "$template_dir" ./User
    if [[ -f "$template_dir/configs/defconfig" ]]; then
        cp "$template_dir/configs/defconfig" ./configs/defconfig
    fi

    {
        echo "# 由 ecos set_board_isolated 生成，请勿手工修改。"
        echo 'BOARD_PACKAGE := $(CURDIR)/Library'
        echo "BOARD_ID := $board_id"
        echo "BOARD_CATEGORY := $board_category"
        [[ -z "$profile" ]] || echo "BOARD_PROFILE := $profile"
        echo "CATEGORY := $board_category"
        echo 'BOARD_KCONFIG := $(CURDIR)/Library/BoardConfig/board.kconfig'
        echo 'DRIVER_KCONFIG := $(CURDIR)/Library/BoardConfig/driver.kconfig'
        echo 'BOARD_DRIVER_DIR := $(CURDIR)/Library/BoardDrivers'
    } > ./configs/board-package.mk

    {
        echo "BOARD=$board_id"
        echo "BOARD_ID=$board_id"
        echo "BOARD_CATEGORY=$board_category"
        [[ -z "$profile" ]] || echo "PROFILE=$profile"
        echo "TYPE=isolated"
        echo "TEMPLATE=$template_name"
    } > ./.ecos-project

    log "Set isolated BSP: $board_id"
    [[ -z "$profile" ]] || log "Build profile: $profile"
    log "Copied BSP resources into Library/ and Startup/."
    return 0
}

# Check if inside a project directory
check_project_dir() {
    if [[ ! -f "Makefile" ]] && [[ ! -f ".ecos-project" ]]; then
        err "Not an ECOS project directory."
        err "Run this command in a directory containing a Makefile or .ecos-project file."
        exit 1
    fi
}

get_config() {
    source .ecos-project

    board_name="${BOARD}"
    project_type="${TYPE:-}"

    echo "Project type: $project_type"
    echo "Board name: $board_name"
}

rewrite_config() {
    if [[ -f ".ecos-project" ]]; then
        source .ecos-project
        project_type="${TYPE:-$project_type}"
    fi

    echo "BOARD=$target_board_name" > ".ecos-project"
    if [[ -n "$project_type" ]]; then
        echo "TYPE=$project_type" >> ".ecos-project"
    fi
}
# Set board configuration
set_board() {
    local target_board_name="$1"
    local profile_request="${2:-}"

    check_project_dir
    if [[ -f .ecos-project ]]; then
        source .ecos-project
        project_type="${TYPE:-}"
        template_name="${TEMPLATE:-hello}"
    fi

    if [[ "$project_type" != "asm" ]] && set_board_from_package "$target_board_name" "$profile_request"; then
        refresh_project_support
        return 0
    fi
    if [[ -n "$profile_request" ]]; then
        err "--profile 只能用于清单中定义了 profiles 的 BSP: $target_board_name"
        exit 1
    fi

    rewrite_config
    get_config

    if [[ "$project_type" == "asm" ]]; then
        local board_sdk_dir=""
        case "$target_board_name" in
            "c2") board_sdk_dir="$SDK_ROOT/board/StarrySkyC2" ;;
            "l3_1") board_sdk_dir="$SDK_ROOT/board/StarrySkyL3_1" ;;
            "l4") board_sdk_dir="$SDK_ROOT/board/StarrySkyL4" ;;
            *)
                err "Unsupported board: $target_board_name"
                exit 1
                ;;
        esac

        rm -f Makefile
        log "Removed Makefile for assembly project."
        log "Board configuration set to: $target_board_name"
        cp "$board_sdk_dir/Makefile_asm" "./Makefile"
        if [[ -f "$board_sdk_dir/flash.ld" ]]; then
            cp "$board_sdk_dir/flash.ld" "./flash.ld"
            log "Set flash-only linker script: ./flash.ld"
        fi
        exit 0
    fi

    case "$target_board_name" in
        "c2")
            local board_file="board.h"
            local make_file="Makefile_isolated"
            local lds_file="sections.lds"
            local start_file="start.S"

            local board_source_path="$SDK_ROOT/board/StarrySkyC2/$board_file"
            local make_source_path="$SDK_ROOT/board/StarrySkyC2/$make_file"
            local lds_source_path="$SDK_ROOT/board/StarrySkyC2/$lds_file"
            local start_source_path="$SDK_ROOT/board/StarrySkyC2/$start_file"
            local driver_source_path="$SDK_ROOT/board/StarrySkyC2/driver"
            local main_source_path="$SDK_ROOT/templates/hello/c2"

            local board_target_path="./Library/board.h"
            local make_target_path="./Makefile"
            local lds_target_path="./Startup/sections.lds"
            local start_target_path="./Startup/start.S"
            local driver_target_path="./Library"
            local main_target_path="./User"

            if [[ ! -f "$board_source_path" ]]; then
                err "Board config file not found: $board_source_path"
                exit 1
            fi

            # Copy Board config file
            cp "$board_source_path" "$board_target_path"
            log "Set board configuration to: starrysky_c2"
            log "Config file: $board_target_path"

            # Copy Makefile
            cp "$make_source_path" "$make_target_path"
            log "Set Makefile: $make_target_path"

            # Copy Linker Script
            if [[ -f "$lds_source_path" ]]; then
                cp "$lds_source_path" "$lds_target_path"
                log "Set Linker Script: $lds_target_path"
            else
                warn "Linker Script not found for C2: $lds_source_path"
            fi

            # Copy Startup Code
            if [[ -f "$start_source_path" ]]; then
                cp "$start_source_path" "$start_target_path"
                log "Set Startup Code: $start_target_path"
            else
                warn "Startup Code not found for C2: $start_source_path"
            fi

            # Copy Drivers
            if [[ -d "$driver_source_path" ]]; then
                replace_board_drivers "$driver_source_path" "$driver_target_path"
                log "Set Drivers: $driver_target_path"
            else
                warn "Drivers not found for C2: $driver_source_path"
            fi

            # C2 has no separate loader. Remove one left by a previous board.
            replace_loader "" "./Startup"

            # Copy Main Files
            if [[ -d "$main_source_path" ]]; then
                install_default_main "$main_source_path" "$main_target_path"
            else
                warn "Main Files not found for C2: $main_source_path"
            fi

            # Update project config file if it exists
            if [[ -f ".ecos-project" ]]; then
                if grep -q "BOARD=" ".ecos-project"; then
                    sed -i "s/BOARD=.*/BOARD=$target_board_name/" ".ecos-project"
                else
                    echo "BOARD=$target_board_name" >> ".ecos-project"
                fi
                log "Updated project configuration file."
            fi
            ;;
        "l3_1")
            local board_file="board.h"
            local make_file="Makefile_isolated"
            local lds_file="sections.lds"
            local start_file="start.S"

            local board_source_path="$SDK_ROOT/board/StarrySkyL3_1/$board_file"
            local make_source_path="$SDK_ROOT/board/StarrySkyL3_1/$make_file"
            local lds_source_path="$SDK_ROOT/board/StarrySkyL3_1/$lds_file"
            local start_source_path="$SDK_ROOT/board/StarrySkyL3_1/$start_file"
            local driver_source_path="$SDK_ROOT/board/StarrySkyL3_1/driver"
            local loader_source_path="$SDK_ROOT/board/StarrySkyL3_1/loader"
            local main_source_path="$SDK_ROOT/templates/hello/l3_1"

            local board_target_path="./Library/board.h"
            local make_target_path="./Makefile"
            local lds_target_path="./Startup/sections.lds"
            local start_target_path="./Startup/start.S"
            local driver_target_path="./Library"
            local loader_target_path="./Startup"
            local main_target_path="./User"

            if [[ ! -f "$board_source_path" ]]; then
                err "Board config file not found: $board_source_path"
                exit 1
            fi

            # Copy Board config file
            cp "$board_source_path" "$board_target_path"
            log "Set board configuration to: starrysky_l3_1"
            log "Config file: $board_target_path"

            # Copy Makefile
            cp "$make_source_path" "$make_target_path"
            log "Set Makefile: $make_target_path"

            # Copy Linker Script
            if [[ -f "$lds_source_path" ]]; then
                cp "$lds_source_path" "$lds_target_path"
                log "Set Linker Script: $lds_target_path"
            else
                warn "Linker Script not found for L3_1: $lds_source_path"
            fi

            # Copy Startup Code
            if [[ -f "$start_source_path" ]]; then
                cp "$start_source_path" "$start_target_path"
                log "Set Startup Code: $start_target_path"
            else
                warn "Startup Code not found for L3_1: $start_source_path"
            fi

            # Copy Drivers
            if [[ -d "$driver_source_path" ]]; then
                replace_board_drivers "$driver_source_path" "$driver_target_path"
                log "Set Drivers: $driver_target_path"
            else
                warn "Drivers not found for L3_1: $driver_source_path"
            fi

            # Copy Loaders
            if [[ -d "$loader_source_path" ]]; then
                replace_loader "$loader_source_path" "$loader_target_path"
                log "Set Loaders: $loader_target_path"
            else
                warn "Loaders not found for L3_1: $loader_source_path"
            fi

            # Copy Main Files
            if [[ -d "$main_source_path" ]]; then
                install_default_main "$main_source_path" "$main_target_path"
            else
                warn "Main Files not found for L3_1: $main_source_path"
            fi

            # Update project config file if it exists
            if [[ -f ".ecos-project" ]]; then
                if grep -q "BOARD=" ".ecos-project"; then
                    sed -i "s/BOARD=.*/BOARD=$target_board_name/" ".ecos-project"
                else
                    echo "BOARD=$target_board_name" >> ".ecos-project"
                fi
                log "Updated project configuration file."
            fi
            ;;
        "l4")
            local board_file="board.h"
            local make_file="Makefile_isolated"
            local lds_file="sections.lds"
            local start_file="start.S"

            local board_source_path="$SDK_ROOT/board/StarrySkyL4/$board_file"
            local make_source_path="$SDK_ROOT/board/StarrySkyL4/$make_file"
            local lds_source_path="$SDK_ROOT/board/StarrySkyL4/$lds_file"
            local start_source_path="$SDK_ROOT/board/StarrySkyL4/$start_file"
            local driver_source_path="$SDK_ROOT/board/StarrySkyL4/driver"
            local loader_source_path="$SDK_ROOT/board/StarrySkyL4/loader"
            local main_source_path="$SDK_ROOT/templates/hello/l4"

            local board_target_path="./Library/board.h"
            local make_target_path="./Makefile"
            local lds_target_path="./Startup/sections.lds"
            local start_target_path="./Startup/start.S"
            local driver_target_path="./Library"
            local loader_target_path="./Startup"
            local main_target_path="./User"

            if [[ ! -f "$board_source_path" ]]; then
                err "Board config file not found: $board_source_path"
                exit 1
            fi

            # Copy Board config file
            cp "$board_source_path" "$board_target_path"
            log "Set board configuration to: starrysky_l4"
            log "Config file: $board_target_path"

            # Copy Makefile
            cp "$make_source_path" "$make_target_path"
            log "Set Makefile: $make_target_path"

            # Copy Linker Script
            if [[ -f "$lds_source_path" ]]; then
                cp "$lds_source_path" "$lds_target_path"
                log "Set Linker Script: $lds_target_path"
            else
                warn "Linker Script not found for L4: $lds_source_path"
            fi

            # Copy Startup Code
            if [[ -f "$start_source_path" ]]; then
                cp "$start_source_path" "$start_target_path"
                log "Set Startup Code: $start_target_path"
            else
                warn "Startup Code not found for L4: $start_source_path"
            fi

            # Copy Drivers
            if [[ -d "$driver_source_path" ]]; then
                replace_board_drivers "$driver_source_path" "$driver_target_path"
                log "Set Drivers: $driver_target_path"
            else
                warn "Drivers not found for L4: $driver_source_path"
            fi

            # Copy Loaders
            if [[ -d "$loader_source_path" ]]; then
                replace_loader "$loader_source_path" "$loader_target_path"
                log "Set Loaders: $loader_target_path"
            else
                warn "Loaders not found for L4: $loader_source_path"
            fi

            # Copy Main Files
            if [[ -d "$main_source_path" ]]; then
                install_default_main "$main_source_path" "$main_target_path"
            else
                warn "Main Files not found for L4: $main_source_path"
            fi

            # Update project config file if it exists
            if [[ -f ".ecos-project" ]]; then
                if grep -q "BOARD=" ".ecos-project"; then
                    sed -i "s/BOARD=.*/BOARD=$target_board_name/" ".ecos-project"
                else
                    echo "BOARD=$target_board_name" >> ".ecos-project"
                fi
                log "Updated project configuration file."
            fi
            ;;
        *)
            err "Unsupported board: $board_name"
            echo ""
            echo "Supported boards:"
            # echo "  c1    StarrySky C1 board"
            echo "  c2    StarrySky C2 board"
            echo "  l3_1    StarrySky L3_1 board"
            echo "  l4      StarrySky L4 board"
            exit 1
            ;;
    esac

    refresh_project_support
}

# Main entry point for the subcommand
if [[ $# -eq 0 ]]; then
    err "Missing board name argument for isolated project."
    exit 1
fi

target_board_name="$1"
shift
if [[ $# -gt 0 ]]; then
    [[ $# -eq 2 && "$1" == "--profile" ]] || {
        err "Usage: ecos set_board_isolated <board_name> [--profile <name>]"
        exit 1
    }
    requested_profile="$2"
fi
set_board "$target_board_name" "$requested_profile"
